{
  "name": "@opennote/storage",
  "version": "0.1.0",
  "private": true,
  "description": "S3-compatible client + presigning (ticket 0007) + SMTP transport (ticket 0006).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./s3": "./dist/s3.js",
    "./smtp": "./dist/smtp.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "nodemailer": "^6.9.16"
  },
  "peerDependencies": {
    "@opennote/config": "workspace:*",
    "@opennote/shared": "workspace:*"
  },
  "devDependencies": {
    "@opennote/config": "workspace:*",
    "@opennote/shared": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

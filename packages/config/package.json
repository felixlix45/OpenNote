{
  "name": "@opennote/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared build config presets + the single-source Zod env schema (ticket 0009).",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tsconfig": "./tsconfig.base.json",
    "./env": "./dist/env.js",
    "./env.d.ts": "./dist/env.d.ts",
    "./package.json": "./package.json"
  },
  "main": "./dist/env.js",
  "types": "./dist/env.d.ts",
  "files": ["dist", "tsconfig.base.json"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}

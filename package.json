{
  "name": "opennote",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "description": "Self-hostable, multi-tenant, real-time, Notion-style notes app.",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @opennote/db db:generate",
    "db:migrate": "pnpm --filter @opennote/db db:migrate",
    "db:push": "pnpm --filter @opennote/db db:push",
    "db:setup": "pnpm --filter @opennote/db db:setup",
    "db:seed": "pnpm --filter @opennote/db db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "name": "@opennote/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Hocuspocus WebSocket server (separate long-lived process, ticket 0004/0009).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.4.0",
    "@hocuspocus/server": "^4.4.0",
    "@opennote/auth": "workspace:*",
    "@opennote/config": "workspace:*",
    "@opennote/db": "workspace:*",
    "@opennote/shared": "workspace:*",
    "pg": "^8.13.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@opennote/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

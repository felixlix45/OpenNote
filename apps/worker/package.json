{
  "name": "@opennote/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background jobs: thumbnail gen, quota recompute, trash purge (ticket 0009).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@opennote/config": "workspace:*",
    "@opennote/db": "workspace:*",
    "@opennote/storage": "workspace:*"
  },
  "devDependencies": {
    "@opennote/config": "workspace:*",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

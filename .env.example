# =============================================================================
# OpenNote — environment template.
# Copy to `.env` and fill in. All vars are validated at boot by
# packages/config/src/env.ts (Zod) — missing required vars fail the process
# before serving any request.
# =============================================================================

# ---------- Runtime ----------
NODE_ENV=development
# Public canonical origin (scheme + host, no trailing slash). Used for cookies,
# OAuth redirects, CORS/WS origin checks, and email links.
APP_URL=http://localhost:3000
REALTIME_PORT=4321
# WS URL the browser editor connects to (ticket 0005). Same-origin /collab path
# is proxied by the dev Caddy service (see docker-compose + Caddyfile.dev) so
# the session cookie flows on the WS upgrade + the realtime origin check passes.
NEXT_PUBLIC_REALTIME_WS_URL=/collab

# ---------- Database (ticket 0003) ----------
DATABASE_URL=postgresql://opennote:opennote@localhost:5433/opennote?schema=public
DB_LOG_QUERIES=false

# ---------- Auth (ticket 0006) ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-32+-char-random-string
# Trusted origins for cookies/CSRF. Defaults to APP_URL; comma-separated for multi-origin.
# AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional OAuth providers (presence enables the provider).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------- SMTP / transactional email (ticket 0006) ----------
# Optional in v1. When unset: invite links shown in UI, password reset disabled.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=opennote@example.com
# SMTP_SECURE=false

# ---------- Storage / attachments (ticket 0007) ----------
# MinIO (self-host default) or any S3-compatible store.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opennote
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
ATTACHMENT_MAX_FILE_BYTES=26214400
ATTACHMENT_WORKSPACE_QUOTA_BYTES=5368709120
ATTACHMENT_SIGNED_URL_TTL_SECONDS=600

# ---------- Search (ticket 0008) ----------
SEARCH_MAX_RESULTS=20

# ---------- Realtime (ticket 0004/0010) ----------
REALTIME_MAX_UPDATES_PER_SECOND=50
REALTIME_DOC_MAX_BYTES=10485760
MAX_NESTING_DEPTH=32

# ---------- Trash retention (ticket 0003) ----------
TRASH_RETENTION_DAYS=30
